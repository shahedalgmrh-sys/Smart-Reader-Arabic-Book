# --- Database (required) --------------------------------------------------
# PostgreSQL connection string, e.g.:
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/book_reader

# --- TTS engine (optional, defaults are sensible) --------------------------
TTS_ENGINE=tts_arabic
TTS_DEVICE=cuda
TTS_SAMPLING_RATE=22050

# --- Optional overrides for the Arabic TTS subset --------------------------
# TTS_ARABIC_PYTORCH_PATH=third_party/tts-arabic-pytorch
# TTS_ACOUSTIC_CKPT=app/models/states_3000.pth
